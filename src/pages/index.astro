                    {testimonials.map((t) => (
                        <div class="min-w-[300px] md:min-w-[400px] snap-center bg-white p-10 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between">
                            <div class="mb-8">
                                <div class="flex gap-1 mb-6">
                                    {[1, 2, 3, 4, 5].map(() => (
                                        <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                    ))}
                                </div>
                                <p class="text-slate-600 text-lg italic leading-relaxed lang-text" data-id={`"${t.text}"`} data-en={`"${t.text_en}"`}>"{t.text}"</p>
                            </div>
                            <div class="flex items-center gap-4 pt-6 border-t border-slate-50">
                                <div class="w-12 h-12 bg-[#4fbed4]/20 rounded-full flex items-center justify-center font-bold text-[#4fbed4]">{t.initials}</div>
                                <div>
                                    <h4 class="font-bold text-slate-900">{t.name}</h4>
                                    <p class="text-slate-400 text-xs uppercase tracking-widest">{t.role}</p>
                                </div>
                            </div>
                        </div>
                    ))}
