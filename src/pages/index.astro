---

<Layout title="Percetakan & Tiket Pesawat Murah Bau-Bau Buton — One Creative (Print, Pelni, Expedisi, Foto)">
    <main>
        <!-- Hero Section -->
        <section class="relative pt-64 pb-48 px-6 overflow-hidden flex items-center min-h-[90vh]">
            <div class="absolute inset-0 z-0">
                <img src="/img/hero-bg.png" alt="Percetakan Bau-Bau - Kantor One Creative Pusat Print & Tiket Murah" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-black/60 backdrop-blur-[2px]"></div>
            </div>
            <div class="container mx-auto max-w-6xl text-center relative z-10 text-white">
                <div class="inline-flex items-center gap-2 mb-8">
                    <span class="bg-white/20 text-white border border-white/30 px-3 py-1 rounded-full uppercase tracking-widest text-[10px] lang-text"
                          data-id="Percetakan Bau-Bau & Layanan Digital" data-en="Bau-Bau Digital Service Center">Percetakan Bau-Bau & Layanan Digital</span>
                </div>
                <h1 class="text-[56px] md:text-[80px] font-semibold leading-[1.04] tracking-[-0.8px] mb-8 max-w-4xl mx-auto lang-text"
                    data-id="Percetakan Bau-Bau & Tiket Pesawat Murah — One Creative."
                    data-en="Bau-Bau Printing & Cheap Flight Tickets — One Creative.">
                    Percetakan Bau-Bau & Tiket Pesawat Murah — One Creative.
                </h1>
                <p class="text-[20px] text-white/80 mb-12 max-w-2xl mx-auto leading-[1.5] lang-text"
                   data-id="Percetakan Bau-Bau terbaik dari PT. ONE CREATIVE AIO: Jasa Print, Tiket Pelni, Tiket Pesawat Murah, Expedisi, dan Editing Foto terlengkap di Bau-Bau & Buton."
                   data-en="Best Bau-Bau Printing from PT. ONE CREATIVE AIO: Print, Pelni Tickets, Cheap Flight Tickets, Expedition, and Photo Editing services in Bau-Bau & Buton.">
                    <strong>Percetakan Bau-Bau</strong> adalah layanan utama dari PT. ONE CREATIVE AIO. Kami menyediakan jasa Print, Tiket Pelni, Tiket Pesawat Murah, Expedisi, dan Editing Foto terlengkap di Bau-Bau & Buton.
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a href="#layanan" class="btn-primary text-white px-10 py-4 font-semibold text-lg shadow-xl shadow-[#4fbed4]/20 lang-text"
                       data-id="Lihat Layanan" data-en="View Services">Lihat Layanan</a>
                    <a href="https://wa.me/6285796792110?text=Halo%20One%20Creative,%20saya%20ingin%20tanya%20tentang%20layanan%20digital." target="_blank" class="border border-white/30 rounded-[4px] px-10 py-4 font-semibold text-lg hover:bg-white/10 transition-all backdrop-blur-sm flex items-center justify-center gap-2 lang-text"
                       data-id="Hubungi Admin" data-en="Contact Admin">
                        Hubungi Admin
                    </a>
                </div>
            </div>
        </section>

        <!-- Services Grid -->
        <section id="layanan" class="py-32 px-6 bg-slate-50">
            <div class="container mx-auto max-w-6xl">
                <div class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8">
                    <div class="max-w-xl">
                        <div class="label-uppercase mb-4 lang-text" style="color: var(--wf-blue);" data-id="Layanan Digital Terpadu" data-en="Integrated Digital Services">Layanan Digital Terpadu</div>
                        <h2 class="text-[40px] md:text-[56px] font-semibold leading-[1.04] lang-text" data-id="Efisiensi Tanpa Batas dalam Satu Atap." data-en="Limitless Efficiency under One Roof.">Efisiensi Tanpa Batas dalam Satu Atap.</h2>
                    </div>
                    <p class="pb-2 text-slate-500 max-w-sm lang-text" data-id="Kami menghadirkan infrastruktur layanan modern untuk memudahkan urusan bisnis dan personal Anda di Bau-Bau." data-en="We provide modern service infrastructure to facilitate your business and personal affairs in Bau-Bau.">Kami menghadirkan infrastruktur layanan modern untuk memudahkan urusan bisnis dan personal Anda di Bau-Bau.</p>
                </div>
                <div class="grid md:grid-cols-2 gap-6">
                    <article class="card-wf p-6 md:p-10 bg-white flex flex-col justify-between min-h-[400px] overflow-hidden">
                        <div>
                            <div class="text-2xl mb-6 md:mb-8" role="img" aria-label="Ikon Keuangan">💸</div>
                            <h3 class="text-[28px] md:text-[32px] font-medium mb-4 lang-text leading-tight" data-id="Top Up Game Bau-Bau & Keuangan" data-en="Bau-Bau Game Top Up & Finance">Top Up Game Bau-Bau & Keuangan</h3>
                            <p class="text-slate-500 text-base md:text-lg lang-text" data-id="Layanan Top Up Game Bau-Bau termurah, transfer antar bank, dan pembayaran tagihan instan." data-en="Cheapest Bau-Bau Game Top Up, interbank transfer, and instant bill payments.">Layanan <strong>Top Up Game Bau-Bau</strong> termurah, transfer antar bank, dan pembayaran tagihan instan.</p>
                        </div>
                        <div class="mt-8 pt-6 border-t border-slate-100 text-xs font-bold uppercase tracking-widest text-slate-300 lang-text" data-id="Pembayaran Instan" data-en="Instant Payment">Pembayaran Instan</div>
                    </article>
                    <article class="card-wf p-6 md:p-10 bg-white flex flex-col justify-between min-h-[400px] overflow-hidden">
                        <div>
                            <div class="text-2xl mb-6 md:mb-8" role="img" aria-label="Ikon Logistik">📦</div>
                            <h3 class="text-[28px] md:text-[32px] font-medium mb-4 lang-text leading-tight" data-id="Tiket Pesawat Murah Bau-Bau & Pelni" data-en="Cheap Bau-Bau Flight Tickets & Pelni">Tiket Pesawat Murah Bau-Bau & Pelni</h3>
                            <p class="text-slate-500 text-base md:text-lg mb-6 lang-text" data-id="Pesan Tiket Pesawat Murah Bau-Bau rute domestik/internasional dan Agen Tiket Pelni resmi." data-en="Book Cheap Bau-Bau Flight Tickets for domestic/international routes and official Pelni Agent.">Pesan <strong>Tiket Pesawat Murah Bau-Bau</strong> rute domestik/internasional dan Agen Tiket Pelni resmi.</p>
                            <a href="/jadwal-kapal-pelni-bau-bau" class="inline-flex items-center gap-2 text-[#146ef5] font-bold text-sm hover:underline bg-blue-50/50 px-4 py-2 rounded-lg border border-blue-100/50 transition-colors hover:bg-blue-50">
                                📅 Cek Jadwal Kapal Terbaru →
                            </a>
                        </div>
                        <div class="mt-8 pt-6 border-t border-slate-100 text-xs font-bold uppercase tracking-widest text-slate-300 lang-text" data-id="Agen Resmi" data-en="Official Agent">Agen Resmi</div>
                    </article>
                </div>
            </div>
        </section>

        <!-- Products Section -->
        <section id="produk" class="py-32 px-6">
            <div class="container mx-auto max-w-7xl">
                <div class="text-center mb-20">
                    <div class="label-uppercase text-slate-400 mb-4 lang-text" data-id="Katalog Layanan Unggulan" data-en="Featured Service Catalog">Katalog Layanan Unggulan</div>
                    <h2 class="text-[40px] md:text-[56px] font-semibold leading-[1.04] mb-6 lang-text" data-id="Katalog Jasa Percetakan & Layanan Digital Bau-Bau" data-en="Bau-Bau Printing & Digital Service Catalog">Katalog Jasa Percetakan & Layanan Digital Bau-Bau</h2>
                    <p class="text-slate-500 max-w-2xl mx-auto text-lg lang-text" data-id="Cetak undangan, top up game, hingga tiket pesawat internasional tersedia lengkap di One Creative Bau-Bau." data-en="Printing invitations, game top ups, to international flight tickets are available completely at One Creative Bau-Bau.">Cetak undangan, top up game, hingga tiket pesawat internasional tersedia lengkap di One Creative Bau-Bau.</p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                    {products.map((product) => (
                        <article class="group card-wf bg-white p-4 hover:border-[#4fbed4] transition-all duration-300">
                            <div class="relative overflow-hidden rounded-xl mb-5 aspect-square border border-slate-100">
                                <img 
                                    src={product.img} 
                                    alt={`${product.name} - Layanan Digital & Percetakan Terbaik di Kota Bau-Bau`} 
                                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                                    width="400"
                                    height="400"
                                    loading="lazy"
                                />
                                <div class="absolute top-3 left-3"><span class="bg-white/90 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-bold shadow-sm">{product.price}</span></div>
                            </div>
                            <h3 class="text-lg font-bold mb-2 lang-text" data-id={product.name} data-en={product.name_en}>{product.name}</h3>
                            <p class="text-slate-500 text-xs mb-6 line-clamp-2 lang-text" data-id={product.desc} data-en={product.desc_en}>{product.desc}</p>
                            <a href={product.url} target="_blank" rel="noopener noreferrer" aria-label={`Pesan ${product.name} via WhatsApp`} class="block w-full py-3 bg-slate-50 text-center rounded-lg font-semibold text-sm hover:bg-[#4fbed4] hover:text-white transition-all lang-text" data-id={product.btnText} data-en={product.btnText_en}>{product.btnText}</a>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <!-- Testimonials Section -->
        <section id="ulasan" class="py-32 px-6 bg-slate-50 overflow-hidden">
            <div class="container mx-auto max-w-6xl">
                <div class="text-center mb-16">
                    <div class="label-uppercase text-slate-400 mb-4 lang-text" data-id="Ulasan Pelanggan" data-en="Customer Reviews">Ulasan Pelanggan</div>
                    <h2 class="text-[40px] md:text-[56px] font-semibold lang-text" data-id="Testimoni Pelanggan One Creative Bau-Bau" data-en="One Creative Bau-Bau Customer Testimonials">Testimoni Pelanggan One Creative Bau-Bau</h2>
                </div>
                
                <div class="flex overflow-x-auto gap-8 pb-12 snap-x snap-mandatory no-scrollbar" style="mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);">
                    <!-- Andi Resky -->
                    <div class="min-w-[300px] md:min-w-[400px] snap-center bg-white p-10 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between hover:border-[#4fbed4] transition-colors">
                        <div class="mb-8">
                            <div class="flex gap-1 mb-6">
                                {[1, 2, 3, 4, 5].map(() => (
                                    <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                ))}
                            </div>
                            <p class="text-slate-600 text-lg italic leading-relaxed lang-text" data-id='"Hasil cetakan dokumen dan fotonya sangat tajam, warna akurat. Pengerjaan juga sangat cepat, bisa ditunggu."' data-en='"The document and photo print results are very sharp, colors are accurate. Work is also very fast, can be waited for."'>"Hasil cetakan dokumen dan fotonya sangat tajam, warna akurat. Pengerjaan juga sangat cepat, bisa ditunggu."</p>
                        </div>
                        <div class="flex items-center gap-4 pt-6 border-t border-slate-50">
                            <div class="w-12 h-12 bg-[#4fbed4]/20 rounded-full flex items-center justify-center font-bold text-[#4fbed4]">AR</div>
                            <div>
                                <h4 class="font-bold text-slate-900">Andi Resky</h4>
                                <p class="text-slate-400 text-xs uppercase tracking-widest">Local Guide</p>
                            </div>
                        </div>
                    </div>

                    <!-- Ihsan -->
                    <div class="min-w-[300px] md:min-w-[400px] snap-center bg-white p-10 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between hover:border-[#4fbed4] transition-colors">
                        <div class="mb-8">
                            <div class="flex gap-1 mb-6">
                                {[1, 2, 3, 4, 5].map(() => (
                                    <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                ))}
                            </div>
                            <p class="text-slate-600 text-lg italic leading-relaxed lang-text" data-id='"Satu tempat untuk semua kebutuhan. Mau print dokumen atau cetak undangan pun bisa di sini."' data-en='"One place for all needs. Printing documents or wedding invitations can all be done here."'>"Satu tempat untuk semua kebutuhan. Mau print dokumen atau cetak undangan pun bisa di sini."</p>
                        </div>
                        <div class="flex items-center gap-4 pt-6 border-t border-slate-50">
                            <div class="w-12 h-12 bg-[#4fbed4]/20 rounded-full flex items-center justify-center font-bold text-[#4fbed4]">I</div>
                            <div>
                                <h4 class="font-bold text-slate-900">Ihsan</h4>
                                <p class="text-slate-400 text-xs uppercase tracking-widest">Pelanggan</p>
                            </div>
                        </div>
                    </div>

                    <!-- Xiao Vann -->
                    <div class="min-w-[300px] md:min-w-[400px] snap-center bg-white p-10 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between hover:border-[#4fbed4] transition-colors">
                        <div class="mb-8">
                            <div class="flex gap-1 mb-6">
                                {[1, 2, 3, 4, 5].map(() => (
                                    <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                ))}
                            </div>
                            <p class="text-slate-600 text-lg italic leading-relaxed lang-text" data-id='"Pelayanan pembelian tiket pelni dan pesawat sangat cepat, dan respon penjual sangat baik."' data-en='"Pelni and flight ticket purchase service is very fast, and the seller response is very good."'>"Pelayanan pembelian tiket pelni dan pesawat sangat cepat, dan respon penjual sangat baik."</p>
                        </div>
                        <div class="flex items-center gap-4 pt-6 border-t border-slate-50">
                            <div class="w-12 h-12 bg-[#4fbed4]/20 rounded-full flex items-center justify-center font-bold text-[#4fbed4]">XV</div>
