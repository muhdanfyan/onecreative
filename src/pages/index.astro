<Layout title="Percetakan & Tiket Pesawat Murah Bau-Bau Buton — One Creative">
    <main>
        <!-- Hero Section -->
        <section class="relative pt-64 pb-48 px-6 overflow-hidden flex items-center min-h-[90vh]">
            <div class="absolute inset-0 z-0">
                <img src="/img/hero-bg.png" alt="Percetakan dan Tiket Pesawat Murah One Creative Bau-Bau Buton" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-black/60 backdrop-blur-[2px]"></div>
            </div>
            <div class="container mx-auto max-w-6xl text-center relative z-10 text-white">
                <div class="inline-flex items-center gap-2 mb-8">
                    <span class="bg-white/20 text-white border border-white/30 px-3 py-1 rounded-full uppercase tracking-widest text-[10px] lang-text"
                          data-id="Pusat Percetakan & Layanan Digital Bau-Bau Buton" data-en="Bau-Bau & Buton Digital Service Center">Pusat Percetakan & Layanan Digital Bau-Bau Buton</span>
                </div>
                <h1 class="text-[56px] md:text-[80px] font-semibold leading-[1.04] tracking-[-0.8px] mb-8 max-w-4xl mx-auto lang-text"
                    data-id="Percetakan & Tiket Pesawat Murah Bau-Bau Buton."
                    data-en="Cheap Printing & Flight Tickets Bau-Bau Buton.">
                    Percetakan & Tiket Pesawat Murah Bau-Bau Buton.
                </h1>
                <p class="text-[20px] text-white/80 mb-12 max-w-2xl mx-auto leading-[1.5] lang-text"
                   data-id="Jasa Print, Percetakan Undangan, Tiket Pesawat Murah, Editing Foto, dan Top Up Game termurah di Kota Bau-Bau & Kabupaten Buton."
                   data-en="Print service, Wedding Invitations, Cheap Flight Tickets, Photo Editing, and cheapest Game Top Up in Bau-Bau City & Buton Regency.">
                    Jasa <strong>Print</strong>, <strong>Percetakan Undangan</strong>, <strong>Tiket Pesawat Murah</strong>, <strong>Editing Foto</strong>, dan Top Up Game termurah di Kota Bau-Bau & Kabupaten Buton.
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a href="#layanan" class="btn-primary text-white px-10 py-4 font-semibold text-lg shadow-xl shadow-[#4fbed4]/20 lang-text"
                       data-id="Lihat Produk Murah" data-en="View Cheap Products">Lihat Produk Murah</a>
                    <a href="https://wa.me/6285796792110?text=Halo%20One%20Creative,%20saya%20ingin%20tanya%20tentang%20layanan%20percetakan%20dan%20tiket%20pesawat." target="_blank" class="border border-white/30 rounded-[4px] px-10 py-4 font-semibold text-lg hover:bg-white/10 transition-all backdrop-blur-sm flex items-center justify-center gap-2 lang-text"
                       data-id="Hubungi Admin" data-en="Contact Admin">
                        Hubungi Admin
                    </a>
                </div>
            </div>
        </section>

        <!-- Services Grid -->
        <section id="layanan" class="py-32 px-6 bg-slate-50">
            <div class="container mx-auto max-w-6xl">
                <div class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8">
                    <div class="max-w-xl">
                        <div class="label-uppercase mb-4 lang-text" style="color: var(--wf-blue);" data-id="Layanan Digital Terpadu" data-en="Integrated Digital Services">Layanan Digital Terpadu</div>
                        <h2 class="text-[40px] md:text-[56px] font-semibold leading-[1.04] lang-text" data-id="Efisiensi Tanpa Batas dalam Satu Atap." data-en="Limitless Efficiency under One Roof.">Efisiensi Tanpa Batas dalam Satu Atap.</h2>
                    </div>
                    <p class="pb-2 text-slate-500 max-w-sm lang-text" data-id="Kami menghadirkan infrastruktur layanan modern untuk memudahkan urusan bisnis dan personal Anda di Bau-Bau." data-en="We provide modern service infrastructure to facilitate your business and personal affairs in Bau-Bau.">Kami menghadirkan infrastruktur layanan modern untuk memudahkan urusan bisnis dan personal Anda di Bau-Bau.</p>
                </div>
                <div class="grid md:grid-cols-2 gap-6">
                    <article class="card-wf p-10 bg-white flex flex-col justify-between h-[400px]">
                        <div><div class="text-2xl mb-8" role="img" aria-label="Ikon Keuangan">💸</div><h3 class="text-[32px] font-medium mb-4 lang-text" data-id="Keuangan & PPOB Bau-Bau" data-en="Finance & PPOB Bau-Bau">Keuangan & PPOB Bau-Bau</h3><p class="text-slate-500 text-lg lang-text" data-id="Layanan transfer antar bank, pembayaran listrik, air, dan iuran BPJS tercepat." data-en="Interbank transfer services, electricity, water, and BPJS contribution payments.">Layanan transfer antar bank, pembayaran listrik, air, dan iuran BPJS tercepat.</p></div>
