            </div>
        </section>

        <!-- Misi Section -->
        <section id="tentang" class="py-32 px-6">
            <div class="container mx-auto max-w-5xl">
                <div class="text-center mb-16">
                    <div class="label-uppercase text-slate-400 mb-8 lang-text" data-id="Solusi Digital Terpadu di Kota Bau-Bau" data-en="Integrated Digital Solution in Bau-Bau City">Solusi Digital Terpadu di Kota Bau-Bau</div>
                    <h2 class="text-[40px] md:text-[56px] font-semibold mb-12 italic lang-text" data-id='"Memberikan akses kemudahan layanan digital bagi seluruh masyarakat Bau-Bau."' data-en='"Providing easy access to digital services for all people of Bau-Bau."'>"Memberikan akses kemudahan layanan digital bagi seluruh masyarakat Bau-Bau."</h2>
                </div>
                <div class="grid md:grid-cols-2 gap-16 items-start text-left">
