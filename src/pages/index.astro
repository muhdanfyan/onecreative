            <div class="container mx-auto max-w-6xl">
                <div class="text-center mb-16">
                    <div class="label-uppercase text-slate-400 mb-4 lang-text" data-id="Ulasan Pelanggan" data-en="Customer Reviews">Ulasan Pelanggan</div>
                    <h2 class="text-[40px] md:text-[56px] font-semibold lang-text" data-id="Testimoni Pelanggan One Creative Bau-Bau" data-en="One Creative Bau-Bau Customer Testimonials">Testimoni Pelanggan One Creative Bau-Bau</h2>
                </div>
                
