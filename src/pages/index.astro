                        <div><div class="text-2xl mb-8" role="img" aria-label="Ikon Logistik">📦</div><h3 class="text-[32px] font-medium mb-4 lang-text" data-id="Logistik & Travel" data-en="Logistics & Travel">Logistik & Travel</h3><p class="text-slate-500 text-lg lang-text" data-id="Kirim paket ekspedisi & booking tiket pesawat/kapal PELNI tanpa antre." data-en="Send expedition packages & book flight/PELNI ship tickets without queuing.">Kirim paket ekspedisi & booking tiket pesawat/kapal PELNI tanpa antre.</p></div>
                        <div class="pt-6 border-t border-slate-100 text-xs font-bold uppercase tracking-widest text-slate-300 lang-text" data-id="Pengiriman Cepat" data-en="Fast Delivery">Pengiriman Cepat</div>
                    </article>
                </div>
            </div>
        </section>

        <!-- Products Section -->
        <section id="produk" class="py-32 px-6">
            <div class="container mx-auto max-w-7xl">
                <div class="text-center mb-20">
                    <div class="label-uppercase text-slate-400 mb-4 lang-text" data-id="Katalog Layanan Unggulan" data-en="Featured Service Catalog">Katalog Layanan Unggulan</div>
