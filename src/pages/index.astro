---
import Layout from '../layouts/Layout.astro';

const products = [
    {
        id: 'print-editing',
        name: 'Print & Editing Profesional',
        desc: 'Edit dokumen, pengetikan, & cetak foto kualitas tinggi dengan teknologi laser terbaru.',
        price: 'Mulai Rp 1.000',
        img: '/img/product-print.png',
        btnText: 'Detail Percetakan'
    },
    {
        id: 'billing-tv',
        name: 'Tagihan Internet & TV',
        desc: 'Bayar Indihome, MNC Vision, My Republic & First Media praktis di satu tempat.',
        price: 'Layanan PPOB',
        img: '/img/product-billing.png',
        btnText: 'Bayar Sekarang'
    },
    {
        id: 'digital-solution',
        name: 'One Stop Digital',
        desc: 'Pusat reservasi tiket, hotel, paket umroh, & topup e-wallet terlengkap di Bau-Bau.',
        price: 'Layanan Lengkap',
        img: '/img/product-services.png',
        btnText: 'Lihat Layanan'
    },
    {
        id: 'bayar-tagihan',
        name: 'Bayar Tagihan Bulanan',
        desc: 'Bayar PLN, PDAM, & Gas PGN 185+ daerah. Proses cepat, bukti bayar sah.',
        price: 'Anti Denda',
        img: '/img/product-pln.png',
        btnText: 'Bayar Tagihan'
    },
    {
        id: 'topup-games',
        name: 'Top Up Games Murah',
        desc: 'Isi Diamond MLBB, FF, PUBG & Voucher Steam Wallet harga termurah di Bau-Bau.',
        price: 'Instan 24 Jam',
        img: '/img/product-games.png',
        btnText: 'Top Up Sekarang'
    },
    {
        id: 'cetak-undangan',
        name: 'Cetak Undangan Erba',
        desc: 'Pilihan katalog undangan pernikahan & khitanan terbaru. Desain unik & berkesan.',
        price: 'Katalog 2024',
        img: '/img/product-undangan.png',
        btnText: 'Lihat Katalog'
    },
    {
        id: 'tiket-last-minute',
        name: 'Flight Last Minute',
        desc: 'Pesan tiket pesawat 60 menit sebelum take-off. Layanan eksklusif Lion Group.',
        price: '60 Menit Ready',
        img: '/img/product-last-minute.png',
        btnText: 'Pesan Tiket'
    },
    {
        id: 'tiket-pesawat',
        name: 'Tiket Pesawat Lengkap',
        desc: 'Terbang ke rute lokal & internasional dengan pilihan maskapai terlengkap & murah.',
        price: '187+ Maskapai',
        img: '/img/product-flights.png',
        btnText: 'Cek Rute'
    },
    {
        id: 'pelni',
        name: 'Tiket Kapal PELNI',
        desc: 'Booking tiket kapal laut PELNI gampang & cepat. Cek jadwal rute Nusantara.',
        price: 'Agen Resmi',
        img: '/img/product-pelni.png',
        btnText: 'Booking Kapal'
    },
    {
        id: 'express',
        name: 'One Creative Express',
        desc: 'Kirim paket ke seluruh Indonesia dengan pilihan beragam ekspedisi terpercaya.',
        price: 'Pickup Gratis',
        img: '/img/product-express.png',
        btnText: 'Kirim Paket'
    }
];
---

<Layout title="One Creative — Percetakan, Tiket, & Solusi Digital Terlengkap di Bau-Bau">
    <!-- Navbar -->
    <header>
        <nav class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
            <div class="container mx-auto px-6 py-4 flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <img src="/img/logo.png" alt="Logo PT. ONE CREATIVE AIO Bau-Bau" class="h-8 w-auto">
                </div>
                <div class="hidden md:flex items-center gap-10">
                    <a href="#layanan" class="text-[15px] font-medium text-slate-600 hover:text-black transition-colors">Layanan</a>
                    <a href="#produk" class="text-[15px] font-medium text-slate-600 hover:text-black transition-colors">Produk</a>
                    <a href="#tentang" class="text-[15px] font-medium text-slate-600 hover:text-black transition-colors">Visi Misi</a>
                    <a href="#lokasi" class="text-[15px] font-medium text-slate-600 hover:text-black transition-colors">Lokasi</a>
                    <a href="https://bit.ly/3DTVhs3" target="_blank" class="btn-primary text-white px-6 py-2.5 text-sm font-semibold shadow-lg">Mulai Konsultasi</a>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <!-- Hero Section -->
        <section class="relative pt-64 pb-48 px-6 overflow-hidden flex items-center min-h-[90vh]">
            <div class="absolute inset-0 z-0">
                <img src="/img/hero-bg.png" alt="Kantor One Creative Bau-Bau - Pusat Layanan Digital" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-black/60 backdrop-blur-[2px]"></div>
            </div>
            <div class="container mx-auto max-w-6xl text-center relative z-10 text-white">
                <div class="inline-flex items-center gap-2 mb-8">
                    <span class="bg-white/20 text-white border border-white/30 px-3 py-1 rounded-full uppercase tracking-widest text-[10px]">Pusat Layanan Digital Bau-Bau</span>
                </div>
                <h1 class="text-[56px] md:text-[80px] font-semibold leading-[1.04] tracking-[-0.8px] mb-8 max-w-4xl mx-auto">
                    Solusi <span style="color: var(--wf-blue);">Percetakan</span> & Layanan Digital Terbaik di Bau-Bau.
                </h1>
                <p class="text-[20px] text-white/80 mb-12 max-w-2xl mx-auto leading-[1.5]">
                    PT. ONE CREATIVE AIO: Partner terpercaya untuk cetak undangan, tiket pesawat, top up game, dan pengiriman paket ekspedisi ke seluruh Indonesia.
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a href="#layanan" class="btn-primary text-white px-10 py-4 font-semibold text-lg shadow-xl shadow-[#4fbed4]/20">Lihat Semua Layanan</a>
                    <a href="https://www.youtube.com/watch?v=fdk8niTzUD8" target="_blank" class="border border-white/30 rounded-[4px] px-10 py-4 font-semibold text-lg hover:bg-white/10 transition-all backdrop-blur-sm flex items-center justify-center gap-2">
                        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                        Tonton Profil
                    </a>
                </div>
            </div>
        </section>

        <!-- Services Grid -->
        <section id="layanan" class="py-32 px-6 bg-slate-50">
            <div class="container mx-auto max-w-6xl">
                <div class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8">
                    <div class="max-w-xl">
                        <div class="label-uppercase mb-4" style="color: var(--wf-blue);">Layanan Digital Terpadu</div>
                        <h2 class="text-[40px] md:text-[56px] font-semibold leading-[1.04]">Efisiensi Tanpa Batas dalam Satu Atap.</h2>
                    </div>
                    <p class="pb-2 text-slate-500 max-w-sm">Kami menghadirkan infrastruktur layanan modern untuk memudahkan urusan bisnis dan personal Anda di Bau-Bau.</p>
                </div>
                <div class="grid md:grid-cols-2 gap-6">
                    <article class="card-wf p-10 bg-white flex flex-col justify-between h-[400px]">
                        <div><div class="text-2xl mb-8" role="img" aria-label="Ikon Keuangan">💸</div><h3 class="text-[32px] font-medium mb-4">Keuangan & PPOB Bau-Bau</h3><p class="text-slate-500 text-lg">Layanan transfer antar bank, pembayaran listrik, air, dan iuran BPJS tercepat.</p></div>
                        <div class="pt-6 border-t border-slate-100 text-xs font-bold uppercase tracking-widest text-slate-300">Pembayaran Instan</div>
                    </article>
                    <article class="card-wf p-10 bg-white flex flex-col justify-between h-[400px]">
                        <div><div class="text-2xl mb-8" role="img" aria-label="Ikon Logistik">📦</div><h3 class="text-[32px] font-medium mb-4">Logistik & Travel</h3><p class="text-slate-500 text-lg">Kirim paket ekspedisi & booking tiket pesawat/kapal PELNI tanpa antre.</p></div>
                        <div class="pt-6 border-t border-slate-100 text-xs font-bold uppercase tracking-widest text-slate-300">Pengiriman Cepat</div>
                    </article>
                </div>
            </div>
        </section>

        <!-- Products Section -->
        <section id="produk" class="py-32 px-6">
            <div class="container mx-auto max-w-7xl">
                <div class="text-center mb-20">
                    <div class="label-uppercase text-slate-400 mb-4">Katalog Layanan Unggulan</div>
                    <h2 class="text-[40px] md:text-[56px] font-semibold leading-[1.04] mb-6">Pilihan Solusi Digital Untuk Anda.</h2>
                    <p class="text-slate-500 max-w-2xl mx-auto text-lg">Cetak undangan, top up game, hingga tiket pesawat internasional tersedia lengkap di One Creative Bau-Bau.</p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                    {products.map((product) => (
                        <article class="group card-wf bg-white p-4 hover:border-[#4fbed4] transition-all duration-300">
                            <div class="relative overflow-hidden rounded-xl mb-5 aspect-square border border-slate-100">
                                <img src={product.img} alt={`Layanan ${product.name} di One Creative Bau-Bau`} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                                <div class="absolute top-3 left-3"><span class="bg-white/90 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-bold shadow-sm">{product.price}</span></div>
                            </div>
                            <h3 class="text-lg font-bold mb-2">{product.name}</h3>
                            <p class="text-slate-500 text-xs mb-6 line-clamp-2">{product.desc}</p>
                            <a href={`/produk/${product.id}`} class="block w-full py-3 bg-slate-50 text-center rounded-lg font-semibold text-sm hover:bg-[#4fbed4] hover:text-white transition-all">{product.btnText}</a>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <!-- Partners Section -->
        <section class="py-24 px-6 bg-slate-50">
            <div class="container mx-auto max-w-6xl">
                <div class="text-center mb-16">
                    <div class="label-uppercase text-slate-400 mb-4">Partner Bisnis Digital</div>
                    <h2 class="text-[32px] md:text-[48px] font-semibold">Ekosistem Digital One Creative.</h2>
                </div>
                <div class="grid md:grid-cols-2 gap-8">
                    <!-- Partner 1 -->
                    <a href="https://k-mart.co.id/signup/invitation?referral=one_creative" target="_blank" class="group bg-white p-8 rounded-2xl border border-slate-200 hover:border-[#4fbed4] transition-all flex items-center gap-6 shadow-sm">
                        <div class="w-16 h-16 bg-[#4fbed4]/10 rounded-xl flex items-center justify-center shrink-0">
                            <span class="text-2xl" role="img" aria-label="Ikon Belanja Digital">🛒</span>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold mb-1 group-hover:text-[#4fbed4] transition-colors">K-Mart Bau-Bau</h3>
                            <p class="text-slate-500 text-sm">Gabung ekosistem belanja digital K-Mart. Partner resmi One Creative.</p>
                        </div>
                    </a>
                    <!-- Partner 2 -->
                    <a href="https://play.google.com/store/apps/details?id=com.marketpulsa.android&referrer=GEV94" target="_blank" class="group bg-white p-8 rounded-2xl border border-slate-200 hover:border-[#4fbed4] transition-all flex items-center gap-6 shadow-sm">
                        <div class="w-16 h-16 bg-[#4fbed4]/10 rounded-xl flex items-center justify-center shrink-0">
                            <span class="text-2xl" role="img" aria-label="Ikon Aplikasi Pulsa">📱</span>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold mb-1 group-hover:text-[#4fbed4] transition-colors">Aplikasi Market Pulsa</h3>
                            <p class="text-slate-500 text-sm">Solusi PPOB & Pulsa termurah di Sulawesi Tenggara.</p>
                        </div>
                    </a>
                </div>
            </div>
        </section>

        <!-- Misi Section -->
        <section id="tentang" class="py-32 px-6">
            <div class="container mx-auto max-w-4xl text-center">
                <div class="label-uppercase text-slate-400 mb-8">Visi & Misi Kami</div>
                <h2 class="text-[40px] md:text-[56px] font-semibold mb-12 italic">"Memberikan akses kemudahan layanan digital bagi seluruh masyarakat Bau-Bau."</h2>
                <div class="grid md:grid-cols-3 gap-12 pt-12 border-t border-slate-100">
                    <div><div class="text-[40px] font-semibold mb-2">08.30</div><div class="label-uppercase text-[10px] text-slate-400">Operasional</div></div>
                    <div><div class="text-[40px] font-semibold mb-2" style="color: var(--wf-blue);">22.00</div><div class="label-uppercase text-[10px] text-slate-400">Jam Istirahat</div></div>
                    <div><div class="text-[40px] font-semibold mb-2">365</div><div class="label-uppercase text-[10px] text-slate-400">Hari Aktif</div></div>
                </div>
            </div>
        </section>

        <!-- Map Section -->
        <section id="lokasi" class="py-32 px-6 bg-white border-t border-slate-100">
            <div class="container mx-auto max-w-6xl">
                <div class="text-center mb-16"><div class="label-uppercase text-slate-400 mb-4">Lokasi One Creative Bau-Bau</div><h2 class="text-[40px] md:text-[56px] font-semibold">Kunjungi Workshop Kami.</h2></div>
                <div class="rounded-2xl overflow-hidden shadow-2xl h-[500px] w-full">
                    <iframe title="Peta Lokasi One Creative Bau-Bau" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3971.6151857883087!2d122.58827119999998!3d-5.4751928!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2da476d381c0e563%3A0x5fdf4f23b6deedb4!2sOne%20Creative!5e0!3m2!1sid!2sid!4v1777220328774!5m2!1sid!2sid" width="100%" height="100%" style="border:0;" loading="lazy"></iframe>
                </div>
                <div class="mt-8 text-center"><a href="https://maps.app.goo.gl/t4Mp99gHDyxprN2i8" target="_blank" class="text-blue-500 font-semibold hover:underline">Petunjuk Arah Google Maps &rarr;</a></div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-black text-white pt-32 pb-16 px-6">
        <div class="container mx-auto max-w-6xl">
            <div class="grid md:grid-cols-2 gap-20 mb-32">
                <div><h2 class="text-[40px] md:text-[56px] font-semibold mb-10">Punya Pertanyaan?<br>Hubungi Admin Kami.</h2><a href="https://bit.ly/3DTVhs3" class="btn-primary inline-block px-10 py-5 text-xl font-bold">WhatsApp One Creative</a></div>
                <div class="flex flex-col justify-between">
                    <div><div class="label-uppercase text-slate-500 mb-6">Alamat Workshop</div><p class="text-2xl font-medium">Jl. Gajah Mada, Lipu, Kec. Betoambari,<br>Kota Bau-Bau, Sulawesi Tenggara.</p></div>
                    <div class="flex gap-10 mt-12">
                        <a href="https://instagram.com/iwan.lipoetra" class="text-slate-400 hover:text-white transition-colors" target="_blank">Instagram</a>
                        <a href="https://www.facebook.com/hamidsahirudin.iwan/" class="text-slate-400 hover:text-white transition-colors" target="_blank">Facebook</a>
                        <a href="https://www.youtube.com/watch?v=fdk8niTzUD8" class="text-slate-400 hover:text-white transition-colors" target="_blank">YouTube</a>
                    </div>
                </div>
            </div>
            <div class="pt-16 border-t border-slate-800 flex justify-between items-center opacity-50">
                <div class="flex items-center gap-4"><img src="/img/logo.png" alt="Logo PT. ONE CREATIVE AIO Bau-Bau" class="h-6"><span class="font-bold text-sm uppercase tracking-widest">PT. ONE CREATIVE AIO</span></div>
                <div class="text-xs">&copy; 2026 One Creative ID. Hak Cipta Dilindungi.</div>
            </div>
        </div>
    </footer>
</Layout>
