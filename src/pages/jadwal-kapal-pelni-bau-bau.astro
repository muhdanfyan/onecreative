---
import Layout from '../layouts/Layout.astro';

const schedule = [
    { ship: 'KM Tidar', date: '2 Mei 2026', time: '03:00 WITA', route: 'Bau-Bau → Makassar – Surabaya' },
    { ship: 'KM Labobar', date: '6 Mei 2026', time: 'Estimasi Pagi', route: 'Bau-Bau → Makassar – Surabaya – Jakarta' },
    { ship: 'KM Dobonsolo', date: '6 Mei 2026', time: '09:00 WITA', route: 'Bau-Bau → Makassar – Surabaya – Jakarta' },
    { ship: 'KM Leuser', date: '10 Mei 2026', time: '10:00 WITA', route: 'Bau-Bau → Makassar – Labuan Bajo – Surabaya' },
    { ship: 'KM Jetliner', date: '6, 10, 13 Mei 2026', time: 'Pagi/Sore', route: 'Bau-Bau → Raha – Kendari (PP)' },
    { ship: 'KM Tilongkabila', date: 'Mei 2026', time: 'Cek Berkala', route: 'Bau-Bau → Makassar – Labuan Bajo – Bali' },
];
---

<Layout 
    title="Jadwal Kapal PELNI Bau-Bau Mei 2026 Terlengkap & Terbaru — One Creative"
    description="Update Jadwal Kapal PELNI dari Pelabuhan Murhum Bau-Bau Mei 2026. Cek jadwal KM Tidar, Labobar, Dobonsolo, Jetliner. Pesan tiket resmi di One Creative Bau-Bau."
>
    <main class="pt-32 pb-24 bg-slate-50 min-h-screen">
        <div class="container mx-auto px-6 max-w-4xl">
            <!-- Breadcrumb for SEO -->
            <nav class="flex mb-8 text-sm text-slate-500" aria-label="Breadcrumb">
                <ol class="flex items-center space-x-2">
                    <li><a href="/" class="hover:text-[#4fbed4]">Beranda</a></li>
                    <li><span class="mx-2">/</span></li>
                    <li class="font-bold text-slate-900">Jadwal PELNI Bau-Bau</li>
                </ol>
            </nav>

            <header class="mb-12">
                <h1 class="text-[40px] md:text-[56px] font-bold leading-tight mb-6 text-slate-900">
                    Jadwal Kapal PELNI Bau-Bau <span class="text-[#4fbed4]">Mei 2026</span>
                </h1>
                <p class="text-lg text-slate-600 leading-relaxed italic border-l-4 border-[#4fbed4] pl-6 py-2">
                    Informasi jadwal keberangkatan kapal PELNI dari Pelabuhan Murhum Kota Bau-Bau terlengkap. Update harian untuk memudahkan perjalanan Anda.
                </p>
            </header>

            <!-- Live Alert Box -->
            <div class="bg-blue-600 text-white p-6 rounded-2xl mb-12 flex items-center gap-6 shadow-lg">
                <div class="text-4xl">📅</div>
                <div>
                    <h2 class="font-bold text-xl mb-1">Butuh Tiket Cepat Tanpa Antre?</h2>
                    <p class="text-blue-100 text-sm">One Creative adalah Agen Resmi Tiket Kapal PELNI di Bau-Bau. Pesan sekarang melalui WhatsApp!</p>
                </div>
                <a href="https://wa.me/6285796792110?text=Halo%20One%20Creative,%20saya%20mau%20pesan%20tiket%20kapal%20PELNI" class="ml-auto bg-white text-blue-600 px-6 py-3 rounded-xl font-bold hover:bg-blue-50 transition-all whitespace-nowrap">Pesan Tiket</a>
            </div>

            <!-- Schedule Table -->
            <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden mb-8">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-900 text-white uppercase text-xs tracking-widest">
                                <th class="p-6 font-bold">Nama Kapal</th>
                                <th class="p-6 font-bold">Tanggal Keberangkatan</th>
                                <th class="p-6 font-bold">Tujuan / Rute</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            {schedule.map((item) => (
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="p-6">
                                        <div class="font-bold text-slate-900">{item.ship}</div>
                                        <div class="text-[10px] text-slate-400 font-bold uppercase">{item.time}</div>
                                    </td>
                                    <td class="p-6 text-slate-600">{item.date}</td>
                                    <td class="p-6 text-[#4fbed4] font-medium">{item.route}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Product Link CTA -->
            <div class="mb-12">
                <a href="/produk/pelni" class="group flex items-center justify-between bg-white p-6 rounded-2xl border-2 border-dashed border-[#4fbed4] hover:border-solid hover:bg-[#4fbed4]/5 transition-all">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-[#4fbed4]/10 rounded-xl flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">🚢</div>
                        <div>
                            <h3 class="font-bold text-slate-900">Lihat Detail Layanan Tiket PELNI</h3>
                            <p class="text-slate-500 text-sm">Informasi lengkap rute, harga, dan persyaratan perjalanan.</p>
                        </div>
                    </div>
                    <span class="text-[#4fbed4] font-bold">Cek Produk →</span>
                </a>
            </div>

            <!-- Content for SEO Depth -->
            <article class="prose prose-slate max-w-none bg-white p-10 rounded-3xl border border-slate-100 shadow-sm">
                <h2 class="text-2xl font-bold mb-6">Cara Pesan Tiket Kapal PELNI di One Creative Bau-Bau</h2>
                <p>Kami melayani pemesanan tiket resmi PELNI untuk seluruh rute di Indonesia dari pelabuhan Bau-Bau. Keuntungan memesan di tempat kami:</p>
                <ul class="list-disc pl-6 space-y-2 mb-8">
                    <li><strong>Tanpa Antre:</strong> Tidak perlu berdesakan di loket pelabuhan.</li>
                    <li><strong>Proses Cepat:</strong> Cukup kirim foto KTP via WhatsApp, tiket langsung jadi.</li>
                    <li><strong>Harga Resmi:</strong> Transparan sesuai tarif PT PELNI.</li>
                    <li><strong>E-Tiket:</strong> Tiket akan dikirimkan dalam format PDF/Gambar yang bisa langsung dipakai untuk check-in.</li>
                </ul>

                <h2 class="text-2xl font-bold mb-6">Lokasi Agen PELNI One Creative</h2>
                <p>Kunjungi workshop kami untuk konsultasi rute dan jadwal lebih mendalam:</p>
                <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 not-italic">
                    <p class="font-bold text-slate-900 mb-1">PT. ONE CREATIVE AIO</p>
                    <p class="text-slate-600">Jl. Gajah Mada, Lipu, Kec. Betoambari, Kota Bau-Bau</p>
                    <p class="text-slate-600">Telepon/WA: +62 857-9679-2110</p>
                </div>
            </article>
        </div>
    </main>
</Layout>
