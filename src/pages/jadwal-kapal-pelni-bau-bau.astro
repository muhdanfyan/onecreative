    <script is:inline>
        window.addEventListener('DOMContentLoaded', () => {
            const btn = document.getElementById('btn-screenshot');
            const btnText = document.getElementById('btn-text');
            const btnIcon = document.getElementById('btn-icon');

            btn?.addEventListener('click', async function() {
                if (typeof html2canvas === 'undefined') {
                    alert('Sedang memuat sistem... Silakan coba dalam 2 detik.');
                    return;
                }

                btn.style.opacity = '0.5';
                btnIcon.innerText = '⏳';
                btnText.innerText = 'Memproses...';

                try {
                    const captureArea = document.getElementById('capture-area');
                    
                    // Surgical Option: Replace oklch strings in all stylesheets with RGB
                    const styleBackups = [];
                    const sanitizeStyles = () => {
                        const styleTags = document.querySelectorAll('style');
                        styleTags.forEach(tag => {
                            styleBackups.push({ tag, content: tag.innerHTML });
                            if (tag.innerHTML.includes('oklch')) {
                                // Simple regex to replace oklch with a neutral color or try to resolve it
                                // For simplicity and stability, we'll replace the problematic function 
                                // names so the parser doesn't trip, or just provide a fallback.
                                tag.innerHTML = tag.innerHTML.replace(/oklch\([^)]+\)/g, 'rgb(0,0,0)');
                            }
                        });
                    };
                    
                    sanitizeStyles();

                    // Bake computed colors into inline styles to preserve the actual colors
                    const elements = captureArea.querySelectorAll('*');
                    const originalStyles = [];
                    elements.forEach(el => {
                        const style = window.getComputedStyle(el);
                        const forceRgb = (colorStr) => {
                            if (colorStr && (colorStr.includes('oklch') || colorStr.includes('oklab') || colorStr.includes('color-mix'))) {
                                const temp = document.createElement('div');
                                temp.style.color = colorStr;
                                document.body.appendChild(temp);
                                const resolved = window.getComputedStyle(temp).color;
                                document.body.removeChild(temp);
                                return resolved;
                            }
                            return colorStr;
                        };
                        
                        originalStyles.push({
                            el: el,
                            color: el.style.color,
                            bg: el.style.backgroundColor,
                            border: el.style.borderColor
                        });

                        el.style.color = forceRgb(style.color);
                        el.style.backgroundColor = forceRgb(style.backgroundColor);
                        el.style.borderColor = forceRgb(style.borderColor);
                    });

                    const canvas = await html2canvas(captureArea, {
                        scale: 3,
                        useCORS: true,
                        allowTaint: true,
                        backgroundColor: '#ffffff',
                        windowWidth: 1200,
                    });
                    
                    // Restore original styles and stylesheets
                    originalStyles.forEach(item => {
                        item.el.style.color = item.color;
                        item.el.style.backgroundColor = item.bg;
                        item.el.style.borderColor = item.border;
                    });
                    styleBackups.forEach(item => {
                        item.tag.innerHTML = item.content;
                    });
                    
                    const image = canvas.toDataURL("image/png");
                    const link = document.createElement('a');
                    link.download = `Jadwal-PELNI-One-Creative-${new Date().toLocaleDateString()}.png`;
                    link.href = image;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    
                    alert('Gambar HD berhasil diunduh! Siap dibagikan ke WhatsApp atau Instagram.');
                } catch (err) {
                    console.error(err);
                    alert('Gagal mengambil screenshot: ' + err.message);
                } finally {
                    btn.style.opacity = '1';
                    btnIcon.innerText = '📸';
                    btnText.innerText = 'Simpan & Bagikan Jadwal';
                }
            });
        });
    </script>
