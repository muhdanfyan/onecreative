---
import Layout from '../layouts/Layout.astro';

const scheduleBarat = [
    { ship: 'KM Tidar', date: '2 Mei 2026', time: '03:00 WITA', route: 'Bau-Bau → Makassar – Surabaya' },
    { ship: 'KM Labobar', date: '6 Mei 2026', time: '08:00 WITA', route: 'Bau-Bau → Makassar – Surabaya – Jakarta' },
    { ship: 'KM Dobonsolo', date: '9 Mei 2026', time: '14:00 WITA', route: 'Bau-Bau → Makassar – Surabaya – Jakarta' },
    { ship: 'KM Ciremai', date: '12 Mei 2026', time: '10:00 WITA', route: 'Bau-Bau → Makassar – Surabaya – Jakarta' },
];

const scheduleTimur = [
    { ship: 'KM Dobonsolo', date: '4 Mei 2026', time: '21:00 WITA', route: 'Bau-Bau → Ambon – Sorong – Jayapura' },
    { ship: 'KM Ciremai', date: '7 Mei 2026', time: '14:00 WITA', route: 'Bau-Bau → Ambon – Sorong – Jayapura' },
    { ship: 'KM Leuser', date: '10 Mei 2026', time: '10:00 WITA', route: 'Bau-Bau → Wanci – Ambon – Timika' },
    { ship: 'KM Sinabung', date: '12 Mei 2026', time: '02:00 WITA', route: 'Bau-Bau → Banggai – Bitung – Ternate' },
];

const scheduleLokal = [
    { ship: 'KM Jetliner', date: '6, 10, 13 Mei 2026', time: 'Pagi/Sore', route: 'Bau-Bau → Raha – Kendari (PP)' },
];
---

<Layout 
    title="Jadwal Kapal PELNI Bau-Bau (Barat & Timur) Mei 2026 Terbaru — One Creative"
    description="Update Jadwal Kapal PELNI Pelabuhan Murhum Bau-Bau Mei 2026 Lengkap. Rute Barat (Makassar/Jawa) & Timur (Ambon/Papua). Agen Resmi One Creative."
>
    <Fragment slot="head">
        <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js" defer></script>
    </Fragment>

    <main class="pt-32 pb-24 bg-[#fcfcfc] min-h-screen relative overflow-hidden">
        
        <!-- Subtle Animated Background Elements -->
        <div class="absolute top-0 left-0 w-full h-[500px] bg-gradient-to-b from-[#146ef5]/5 to-transparent -z-10"></div>
        <div class="fixed inset-0 flex items-center justify-center pointer-events-none z-0 opacity-[0.02]">
            <img src="/img/logo.png" alt="" class="w-[600px] grayscale">
        </div>

        <div class="container mx-auto px-6 max-w-6xl relative z-10">
            <!-- Breadcrumb -->
            <nav class="flex mb-8 text-[10px] font-extrabold uppercase tracking-[0.2em] text-slate-400" aria-label="Breadcrumb">
                <ol class="flex items-center space-x-3">
                    <li><a href="/" class="hover:text-[#146ef5] transition-colors">Beranda</a></li>
                    <li><span class="text-slate-200">/</span></li>
                    <li class="text-slate-900">Jadwal Kapal Pelni</li>
                </ol>
            </nav>

            <header class="mb-16 text-center md:text-left">
                <div class="inline-flex items-center gap-2 bg-[#146ef5] text-white px-4 py-1.5 rounded-full text-[10px] font-bold uppercase tracking-widest mb-6 shadow-lg shadow-[#146ef5]/20">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
                    </span>
                    Update Mei 2026
                </div>
                <h1 class="text-[44px] md:text-[64px] font-semibold leading-[1.05] tracking-[-0.03em] text-[#080808] mb-6">
                    Jadwal Kapal PELNI <br class="hidden md:block"/><span class="text-[#146ef5]">Pelabuhan Murhum Bau-Bau</span>
                </h1>
                <p class="text-xl text-slate-500 max-w-2xl leading-relaxed">
                    Informasi lengkap keberangkatan kapal ke arah <span class="text-blue-600 font-bold">Barat (Jawa/Makassar)</span> dan <span class="text-orange-600 font-bold">Timur (Maluku/Papua)</span>.
                </p>
            </header>

            <!-- Main Capture Area -->
            <div id="capture-area" class="bg-white p-1 rounded-[40px] shadow-stack mb-16 border border-slate-100">
                <div class="bg-white p-6 md:p-12 rounded-[36px] border border-slate-50 relative overflow-hidden">
                    
                    <!-- Branding Header for Image -->
                    <div class="flex justify-between items-center mb-12 pb-8 border-b border-slate-100">
                        <div>
                            <p class="text-[10px] font-bold text-[#146ef5] uppercase tracking-[0.2em] mb-2">Jadwal Keberangkatan Resmi</p>
                            <h2 class="text-2xl font-bold text-slate-900">ONE CREATIVE BAU-BAU</h2>
                        </div>
                        <img src="/img/logo.png" alt="Logo" class="h-10 w-auto">
                    </div>

                    <div class="grid lg:grid-cols-2 gap-12">
                        
                        <!-- Arah Barat Section -->
                        <div>
                            <div class="flex items-center gap-3 mb-8">
                                <div class="w-10 h-10 bg-blue-600 text-white rounded-xl flex items-center justify-center shadow-lg">⬅️</div>
                                <h3 class="text-xl font-bold text-slate-900">Rute Arah Barat <span class="text-sm font-normal text-slate-400 block tracking-tight">Makassar, Surabaya, Jakarta</span></h3>
                            </div>
                            <div class="space-y-4">
                                {scheduleBarat.map((item) => (
                                    <div class="group p-5 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:border-[#146ef5] hover:shadow-xl transition-all duration-300">
                                        <div class="flex justify-between items-start mb-3">
                                            <div class="font-bold text-lg text-slate-900">{item.ship}</div>
                                            <div class="text-[10px] font-black text-blue-600 bg-blue-50 px-2.5 py-1 rounded-md uppercase tracking-wider">Barat</div>
                                        </div>
                                        <div class="flex items-center gap-4 text-sm text-slate-500 mb-3">
                                            <div class="flex items-center gap-1.5"><span class="opacity-70">📅</span> {item.date}</div>
                                            <div class="flex items-center gap-1.5"><span class="opacity-70">⏰</span> {item.time}</div>
                                        </div>
                                        <div class="text-sm font-medium text-[#146ef5]">{item.route}</div>
                                    </div>
                                ))}
                            </div>
                        </div>

                        <!-- Arah Timur Section -->
                        <div>
                            <div class="flex items-center gap-3 mb-8">
                                <div class="w-10 h-10 bg-orange-500 text-white rounded-xl flex items-center justify-center shadow-lg">➡️</div>
                                <h3 class="text-xl font-bold text-slate-900">Rute Arah Timur <span class="text-sm font-normal text-slate-400 block tracking-tight">Ambon, Sorong, Jayapura, Timika</span></h3>
                            </div>
                            <div class="space-y-4">
                                {scheduleTimur.map((item) => (
                                    <div class="group p-5 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:border-orange-400 hover:shadow-xl transition-all duration-300">
                                        <div class="flex justify-between items-start mb-3">
                                            <div class="font-bold text-lg text-slate-900">{item.ship}</div>
                                            <div class="text-[10px] font-black text-orange-600 bg-orange-50 px-2.5 py-1 rounded-md uppercase tracking-wider">Timur</div>
                                        </div>
                                        <div class="flex items-center gap-4 text-sm text-slate-500 mb-3">
                                            <div class="flex items-center gap-1.5"><span class="opacity-70">📅</span> {item.date}</div>
                                            <div class="flex items-center gap-1.5"><span class="opacity-70">⏰</span> {item.time}</div>
                                        </div>
                                        <div class="text-sm font-medium text-orange-600">{item.route}</div>
                                    </div>
                                ))}
                            </div>
                        </div>

                    </div>

                    <!-- Local / Short Route -->
                    <div class="mt-12 p-6 rounded-2xl bg-[#080808] text-white flex flex-col md:flex-row justify-between items-center gap-6">
                        <div class="flex items-center gap-4 text-center md:text-left">
                            <div class="text-3xl">🛥️</div>
                            <div>
                                <h4 class="font-bold text-lg">Rute Lokal (KM Jetliner)</h4>
                                <p class="text-slate-400 text-sm">{scheduleLokal[0].route} — {scheduleLokal[0].date}</p>
                            </div>
                        </div>
                        <div class="bg-white/10 px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-widest">Wanci - Bau Bau - Raha - Kendari</div>
                    </div>

                    <!-- Screenshot Footer CTA -->
                    <div class="flex flex-col md:flex-row justify-between items-center gap-8 mt-12 pt-12 border-t border-slate-100">
                        <div class="text-center md:text-left">
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-[0.2em] mb-2">Booking Cepat via WhatsApp</p>
                            <p class="text-xl font-bold text-slate-900">+62 857-9679-2110</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 bg-[#146ef5]/10 rounded-full flex items-center justify-center">
                                <img src="/img/logo.png" alt="" class="h-5 w-auto">
                            </div>
                            <span class="text-sm font-bold text-slate-800">Agen Resmi Tiket Kapal PELNI</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Interaction Buttons -->
            <div class="flex flex-wrap gap-6 justify-center">
                <button id="btn-screenshot" class="group bg-[#080808] text-white px-12 py-6 rounded-2xl font-bold text-xl hover:scale-[1.03] active:scale-[0.97] transition-all flex items-center gap-4 shadow-2xl">
                    <span id="btn-icon" class="text-3xl">📸</span> 
                    <span id="btn-text">Simpan & Bagikan Jadwal</span>
                </button>
                <a href="https://wa.me/6285796792110?text=Halo%20One%20Creative,%20saya%20ingin%20booking%20tiket%20kapal%20PELNI" class="bg-white text-slate-900 border-2 border-slate-200 px-12 py-6 rounded-2xl font-bold text-xl hover:bg-slate-50 transition-all shadow-lg flex items-center gap-3">
                    💬 Chat Admin
                </a>
            </div>

            <!-- Detail Product Link -->
            <div class="mt-32 max-w-3xl mx-auto text-center">
                <h3 class="text-2xl font-bold mb-8">Butuh Informasi Lengkap Persyaratan Kapal?</h3>
                <a href="/produk/pelni" class="inline-flex items-center gap-4 p-2 pl-6 bg-white border border-slate-100 rounded-full shadow-lg hover:shadow-xl transition-all group">
                    <span class="font-bold text-slate-700">Lihat Detail Layanan Tiket PELNI</span>
                    <div class="w-10 h-10 bg-[#146ef5] text-white rounded-full flex items-center justify-center group-hover:translate-x-1 transition-transform">→</div>
                </a>
            </div>

        </div>
    </main>

    <script is:inline>
        window.addEventListener('DOMContentLoaded', () => {
            const btn = document.getElementById('btn-screenshot');
            const btnText = document.getElementById('btn-text');
            const btnIcon = document.getElementById('btn-icon');

            btn?.addEventListener('click', async function() {
                if (typeof html2canvas === 'undefined') {
                    alert('Sedang memuat sistem... Silakan coba dalam 2 detik.');
                    return;
                }

                btn.style.opacity = '0.5';
                btnIcon.innerText = '⏳';
                btnText.innerText = 'Memproses...';

                try {
                    const captureArea = document.getElementById('capture-area');
                    const canvas = await html2canvas(captureArea, {
                        scale: 3, // Ultra high res for status share
                        useCORS: true,
                        allowTaint: true,
                        backgroundColor: '#ffffff',
                        windowWidth: 1200, // Ensure desktop layout in screenshot
                    });
                    
                    const image = canvas.toDataURL("image/png");
                    const link = document.createElement('a');
                    link.download = `Jadwal-PELNI-One-Creative-${new Date().toLocaleDateString()}.png`;
                    link.href = image;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    
                    alert('Gambar HD berhasil diunduh! Siap dibagikan ke WhatsApp atau Instagram.');
                } catch (err) {
                    console.error(err);
                    alert('Gagal mengambil screenshot. Hubungi admin.');
                } finally {
                    btn.style.opacity = '1';
                    btnIcon.innerText = '📸';
                    btnText.innerText = 'Simpan & Bagikan Jadwal';
                }
            });
        });
    </script>
</Layout>

<style>
    .shadow-stack {
        box-shadow: rgba(0, 0, 0, 0) 0px 84px 24px, rgba(0, 0, 0, 0.01) 0px 54px 22px, rgba(0, 0, 0, 0.04) 0px 30px 18px, rgba(0, 0, 0, 0.08) 0px 13px 13px, rgba(0, 0, 0, 0.09) 0px 3px 7px;
    }
    /* Hide scrollbar for clean design */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
