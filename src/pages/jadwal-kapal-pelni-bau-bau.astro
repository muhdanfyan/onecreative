---
import Layout from '../layouts/Layout.astro';

const scheduleBarat = [
    { ship: 'KM Tidar', date: '2 Mei 2026', time: '03:00 WITA', route: 'Bau-Bau → Makassar – Surabaya' },
    { ship: 'KM Labobar', date: '6 Mei 2026', time: '08:00 WITA', route: 'Bau-Bau → Makassar – Surabaya – Jakarta' },
    { ship: 'KM Lambelu', date: '8 Mei 2026', time: '12:00 WITA', route: 'Bau-Bau → Makassar – Balikpapan – Nunukan' },
    { ship: 'KM Dobonsolo', date: '9 Mei 2026', time: '14:00 WITA', route: 'Bau-Bau → Makassar – Surabaya – Jakarta' },
    { ship: 'KM Dorolonda', date: '11 Mei 2026', time: '18:00 WITA', route: 'Bau-Bau → Makassar – Surabaya – Jakarta' },
    { ship: 'KM Gunung Dempo', date: '15 Mei 2026', time: '04:00 WITA', route: 'Bau-Bau → Makassar – Surabaya – Jakarta' },
    { ship: 'KM Tilongkabila', date: '18 Mei 2026', time: '23:00 WITA', route: 'Bau-Bau → Makassar – Labuan Bajo – Bali' },
];

const scheduleTimur = [
    { ship: 'KM Dobonsolo', date: '4 Mei 2026', time: '21:00 WITA', route: 'Bau-Bau → Ambon – Sorong – Jayapura' },
    { ship: 'KM Ciremai', date: '7 Mei 2026', time: '14:00 WITA', route: 'Bau-Bau → Ambon – Sorong – Jayapura' },
    { ship: 'KM Leuser', date: '10 Mei 2026', time: '10:00 WITA', route: 'Bau-Bau → Wanci – Ambon – Timika' },
    { ship: 'KM Nggapulu', date: '11 Mei 2026', time: '02:00 WITA', route: 'Bau-Bau → Ambon – Banda – Tual – Fakfak' },
    { ship: 'KM Sinabung', date: '12 Mei 2026', time: '02:00 WITA', route: 'Bau-Bau → Banggai – Bitung – Ternate' },
    { ship: 'KM Gunung Dempo', date: '20 Mei 2026', time: '05:00 WITA', route: 'Bau-Bau → Sorong – Manokwari – Jayapura' },
    { ship: 'KM Tidar', date: '22 Mei 2026', time: '09:00 WITA', route: 'Bau-Bau → Namlea – Ambon – Tual' },
];

const scheduleLokal = [
    { ship: 'KM Jetliner', date: '6, 10, 13 Mei 2026', time: 'Pagi/Sore', route: 'Bau-Bau → Raha – Kendari (PP)' },
];
---

<Layout 
    title="Jadwal Kapal PELNI Baubau Mei 2026 Terbaru & Terlengkap — One Creative"
    description="Update Jadwal Kapal PELNI Pelabuhan Murhum Baubau Mei 2026 Lengkap. Rute Barat (Makassar, Surabaya, Jakarta) & Timur (Ambon, Sorong, Jayapura). Agen Resmi One Creative."
>
    <Fragment slot="head">
        <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js" defer></script>
        
        <!-- Structured Data for Schedule Table -->
        <script type="application/ld+json" define:vars={{ scheduleBarat, scheduleTimur }}>
        {
          "@context": "https://schema.org",
          "@type": "Dataset",
          "name": "Jadwal Kapal PELNI Baubau Mei 2026",
          "description": "Jadwal keberangkatan kapal PELNI dari Pelabuhan Murhum Baubau ke rute Barat dan Timur.",
          "publisher": {
            "@type": "Organization",
            "name": "One Creative Bau-Bau"
          },
          "hasPart": [
            {
              "@type": "Dataset",
              "name": "Rute Barat (Makassar, Surabaya, Jakarta)",
              "description": "Jadwal kapal PELNI Baubau arah Barat"
            },
            {
              "@type": "Dataset",
              "name": "Rute Timur (Ambon, Papua)",
              "description": "Jadwal kapal PELNI Baubau arah Timur"
            }
          ]
        }
        </script>
    </Fragment>

    <main class="pt-32 pb-24 bg-[#fcfcfc] min-h-screen relative overflow-hidden">
        
        <!-- Subtle Animated Background Elements -->
        <div class="absolute top-0 left-0 w-full h-[500px] bg-gradient-to-b from-[#146ef5]/5 to-transparent -z-10"></div>
        <div class="fixed inset-0 flex items-center justify-center pointer-events-none z-0 opacity-[0.02]">
            <img src="/img/logo.png" alt="" class="w-[600px] grayscale">
        </div>

        <div class="container mx-auto px-6 max-w-6xl relative z-10">
            <!-- Breadcrumb -->
            <nav class="flex mb-6 md:mb-8 text-[9px] md:text-[10px] font-extrabold uppercase tracking-[0.2em] text-slate-400" aria-label="Breadcrumb">
                <ol class="flex items-center space-x-3">
                    <li><a href="/" class="hover:text-[#146ef5] transition-colors">Beranda</a></li>
                    <li><span class="text-slate-200">/</span></li>
                    <li class="text-slate-900">Jadwal Kapal Pelni Baubau</li>
                </ol>
            </nav>

            <header class="mb-10 md:mb-16 text-center md:text-left">
                <div class="inline-flex items-center gap-2 bg-[#146ef5] text-white px-3 md:px-4 py-1 md:py-1.5 rounded-full text-[9px] md:text-[10px] font-bold uppercase tracking-widest mb-4 md:mb-6 shadow-lg shadow-[#146ef5]/20">
                    <span class="relative flex h-1.5 w-1.5 md:h-2 md:w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-1.5 w-1.5 md:h-2 md:w-2 bg-white"></span>
                    </span>
                    Update Mei 2026
                </div>
                <h1 class="text-[clamp(1.75rem,8vw,4rem)] font-bold leading-[1.1] tracking-[-0.03em] text-[#080808] mb-6">
                    Jadwal Kapal PELNI <br class="hidden md:block"/><span class="text-[#146ef5]">Baubau (Pelabuhan Murhum)</span>
                </h1>
                <p class="text-lg md:text-xl text-slate-500 max-w-2xl leading-relaxed mx-auto md:mx-0">
                    Informasi lengkap keberangkatan <strong class="text-slate-900">jadwal kapal PELNI Baubau</strong> ke rute <span class="text-blue-600 font-bold">Barat</span> dan <span class="text-orange-600 font-bold">Timur</span>.
                </p>
            </header>

            <!-- Main Capture Area -->
            <div id="capture-area" class="bg-white p-1 rounded-[40px] shadow-stack mb-16 border border-slate-100">
                <div class="bg-white p-6 md:p-12 rounded-[36px] border border-slate-50 relative overflow-hidden">
                    
                    <!-- Branding Header for Image -->
                    <div class="flex flex-col sm:flex-row justify-between items-center gap-[1.5rem] mb-[2rem] md:mb-[3rem] pb-[1.5rem] md:pb-[2rem] border-b border-slate-100">
                        <div class="text-center sm:text-left">
                            <p class="text-[clamp(0.5rem,1.5vw,0.625rem)] font-bold text-[#146ef5] uppercase tracking-[0.2em] mb-1">Jadwal Keberangkatan Resmi</p>
                            <h2 class="text-[clamp(1.1rem,4vw,1.5rem)] font-bold text-slate-900 leading-none">ONE CREATIVE BAU-BAU</h2>
                        </div>
                        <img src="/img/logo.png" alt="Logo" class="h-[clamp(1.5rem,5vw,2.5rem)] w-auto shrink-0">
                    </div>

                    <div class="grid lg:grid-cols-2 gap-12">
                        
                        <!-- Arah Barat Section -->
                        <div>
                            <div class="flex items-center gap-2 md:gap-3 mb-6 md:mb-8">
                                <div class="w-7 h-7 sm:w-8 sm:h-8 md:w-10 md:h-10 bg-blue-600 text-white rounded-lg md:rounded-xl flex items-center justify-center shadow-lg text-xs md:text-base">⬅️</div>
                                <h3 class="text-base sm:text-lg md:text-xl font-bold text-slate-900">Rute Arah Barat <span class="text-[11px] sm:text-xs md:text-sm font-normal text-slate-400 block tracking-tight">Makassar, Surabaya, Jakarta</span></h3>
                            </div>
                            <div class="space-y-3 md:space-y-4">
                                {scheduleBarat.map((item) => (
                                    <div class="group p-[1.25rem] sm:p-[1.5rem] rounded-[1.25rem] border border-slate-100 bg-[#f8fafc] hover:bg-white hover:border-[#146ef5] hover:shadow-xl transition-all duration-300 overflow-hidden relative">
                                        <div class="flex justify-between items-start gap-[0.75rem] mb-[1rem]">
                                            <div class="font-bold text-[clamp(1rem,3.5vw,1.25rem)] text-slate-900 leading-[1.2] min-w-0 break-words">{item.ship}</div>
                                            <div class="text-[0.625rem] font-black text-blue-600 bg-blue-50 px-[0.75rem] py-[0.35rem] rounded-md uppercase tracking-wider shrink-0">Barat</div>
                                        </div>
                                        <div class="flex flex-wrap items-center gap-x-[1.25rem] gap-y-[0.5rem] text-[0.85rem] md:text-[0.9375rem] text-slate-500 mb-[1rem]">
                                            <div class="flex items-center gap-[0.5rem] whitespace-nowrap"><span class="opacity-70">📅</span> {item.date}</div>
                                            <div class="flex items-center gap-[0.5rem] whitespace-nowrap"><span class="opacity-70">⏰</span> {item.time}</div>
                                        </div>
                                        <div class="text-[0.85rem] md:text-[0.9375rem] font-medium text-[#146ef5] leading-relaxed break-words">{item.route}</div>
                                    </div>
                                ))}
                            </div>
                        </div>

                        <!-- Arah Timur Section -->
                        <div>
                            <div class="flex items-center gap-3 mb-6 md:mb-8">
                                <div class="w-8 h-8 md:w-10 md:h-10 bg-orange-500 text-white rounded-lg md:rounded-xl flex items-center justify-center shadow-lg text-sm md:text-base">➡️</div>
                                <h3 class="text-lg md:text-xl font-bold text-slate-900">Rute Arah Timur <span class="text-[0.75rem] md:text-[0.875rem] font-normal text-slate-400 block tracking-tight">Ambon, Sorong, Jayapura, Timika</span></h3>
                            </div>
                            <div class="space-y-4">
                                {scheduleTimur.map((item) => (
                                    <div class="group p-[1.25rem] sm:p-[1.5rem] rounded-[1.25rem] border border-slate-100 bg-[#f8fafc] hover:bg-white hover:border-orange-400 hover:shadow-xl transition-all duration-300 overflow-hidden relative">
                                        <div class="flex justify-between items-start gap-[0.75rem] mb-[1rem]">
                                            <div class="font-bold text-[clamp(1rem,3.5vw,1.25rem)] text-slate-900 leading-[1.2] min-w-0 break-words">{item.ship}</div>
                                            <div class="text-[0.625rem] font-black text-orange-600 bg-orange-50 px-[0.75rem] py-[0.35rem] rounded-md uppercase tracking-wider shrink-0">Timur</div>
                                        </div>
                                        <div class="flex flex-wrap items-center gap-x-[1.25rem] gap-y-[0.5rem] text-[0.85rem] md:text-[0.9375rem] text-slate-500 mb-[1rem]">
                                            <div class="flex items-center gap-[0.5rem] whitespace-nowrap"><span class="opacity-70">📅</span> {item.date}</div>
                                            <div class="flex items-center gap-[0.5rem] whitespace-nowrap"><span class="opacity-70">⏰</span> {item.time}</div>
                                        </div>
                                        <div class="text-[0.85rem] md:text-[0.9375rem] font-medium text-orange-600 leading-relaxed break-words">{item.route}</div>
                                    </div>
                                ))}
                            </div>
                        </div>

                    </div>

                    <!-- Local / Short Route -->
                    <div class="mt-8 md:mt-12 p-4 md:p-6 rounded-xl md:rounded-2xl bg-[#080808] text-white flex flex-col md:flex-row justify-between items-center gap-4 md:gap-6 overflow-hidden">
                        <div class="flex items-center gap-3 md:gap-4 text-center md:text-left min-w-0">
                            <div class="text-2xl md:text-3xl shrink-0">🛥️</div>
                            <div class="min-w-0">
                                <h4 class="font-bold text-base md:text-lg truncate">Rute Lokal (KM Jetliner)</h4>
                                <p class="text-slate-400 text-xs md:text-sm truncate">{scheduleLokal[0].route} — {scheduleLokal[0].date}</p>
                            </div>
                        </div>
                        <div class="bg-[#ffffff1a] px-3 md:px-4 py-1.5 md:py-2 rounded-lg text-[10px] md:text-xs font-bold uppercase tracking-widest text-center break-words max-w-full">Wanci - Bau Bau - Raha - Kendari</div>
                    </div>

                    <!-- Screenshot Footer CTA -->
                    <div class="flex flex-col md:flex-row justify-between items-center gap-6 md:gap-8 mt-8 md:mt-12 pt-8 md:pt-12 border-t border-slate-100 overflow-hidden w-full">
                        <div class="flex flex-col md:flex-row gap-6 md:gap-16 w-full md:w-auto">
                            <div class="text-center md:text-left">
                                <p class="text-[10px] md:text-xs font-bold text-slate-400 uppercase tracking-[0.2em] mb-1 md:mb-2">Booking via WhatsApp</p>
                                <p class="text-lg md:text-xl font-bold text-slate-900 break-all">+62 857-9679-2110</p>
                            </div>
                            <div class="text-center md:text-left">
                                <p class="text-[10px] md:text-xs font-bold text-slate-400 uppercase tracking-[0.2em] mb-1 md:mb-2">Website Resmi</p>
                                <p class="text-lg md:text-xl font-bold text-slate-900 break-all">onecreative.id</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 shrink-0">
                            <div class="w-8 h-8 md:w-10 md:h-10 bg-[#146ef51a] rounded-full flex items-center justify-center shrink-0">
                                <img src="/favicon.png" alt="" class="h-4 md:h-5 w-auto">
                            </div>
                            <span class="text-xs md:text-sm font-bold text-slate-800 whitespace-nowrap">Agen Resmi Tiket Pelni</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Interaction Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 md:gap-6 justify-center px-4">
                <button id="btn-screenshot" class="group bg-[#080808] text-white px-8 md:px-12 py-4 md:py-6 rounded-xl md:rounded-2xl font-bold text-lg md:text-xl hover:scale-[1.03] active:scale-[0.97] transition-all flex items-center justify-center gap-3 md:gap-4 shadow-2xl">
                    <span id="btn-icon" class="text-2xl md:text-3xl">📸</span> 
                    <span id="btn-text">Simpan & Bagikan</span>
                </button>
                <a href="https://wa.me/6285796792110?text=Halo%20One%20Creative,%20saya%20ingin%20booking%20tiket%20kapal%20PELNI" class="bg-white text-slate-900 border-2 border-slate-200 px-8 md:px-12 py-4 md:py-6 rounded-xl md:rounded-2xl font-bold text-lg md:text-xl hover:bg-slate-50 transition-all shadow-lg flex items-center justify-center gap-3">
                    <span class="text-xl">💬</span> Chat Admin
                </a>
            </div>

            <!-- SEO Text Section -->
            <section class="mt-12 md:mt-20 grid md:grid-cols-2 gap-8 md:gap-12 text-slate-600 leading-relaxed border-t border-slate-100 pt-10 md:pt-16 px-4 md:px-0">
                <div>
                    <h2 class="text-xl md:text-2xl font-bold text-slate-900 mb-4 md:mb-6 leading-tight">Cara Cek Jadwal Kapal PELNI Baubau Terbaru 2026</h2>
                    <p class="mb-4 text-[15px] md:text-base text-justify md:text-left">
                        Mencari informasi <strong class="text-[#146ef5]">jadwal kapal PELNI Baubau</strong> kini lebih mudah melalui One Creative. Kami menyediakan update real-time untuk keberangkatan dari Pelabuhan Murhum Baubau menuju berbagai kota di Indonesia.
                    </p>
                    <div class="bg-blue-50 p-5 md:p-6 rounded-xl md:rounded-2xl border border-blue-100">
                        <h3 class="font-bold text-blue-900 mb-2 text-sm md:text-base">Rute Populer:</h3>
                        <ul class="text-xs md:text-sm space-y-1 text-blue-800">
                            <li>• Jadwal Kapal PELNI Baubau - Makassar</li>
                            <li>• Jadwal Kapal PELNI Baubau - Surabaya</li>
                            <li>• Jadwal Kapal PELNI Baubau - Ambon</li>
                        </ul>
                    </div>
                </div>
                <div>
                    <h2 class="text-xl md:text-2xl font-bold text-slate-900 mb-4 md:mb-6 leading-tight">Agen Resmi Tiket Kapal PELNI di Baubau</h2>
                    <p class="mb-4 text-[15px] md:text-base text-justify md:text-left">
                        Sebagai <strong class="text-slate-900">agen resmi tiket pelni baubau</strong>, One Creative memberikan solusi praktis. Anda tidak perlu lagi mengantre lama di loket pelabuhan.
                    </p>
                    <ul class="space-y-3 bg-white p-5 md:p-6 rounded-xl md:rounded-2xl shadow-sm border border-slate-100">
                        <li class="flex items-start gap-3">
                            <span class="text-blue-600 font-bold">📍</span>
                            <div>
                                <strong class="text-slate-900 block text-sm md:text-base leading-none mb-1">Alamat Kantor:</strong>
                                <span class="text-xs md:text-sm">Jl. Gajah Mada, Lipu, Betoambari, Baubau.</span>
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-green-600 font-bold">📞</span>
                            <div>
                                <strong class="text-slate-900 block text-sm md:text-base leading-none mb-1">WhatsApp:</strong>
                                <span class="text-xs md:text-sm">+62 857-9679-2110 (Admin)</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </section>

            <!-- Testimonials Section -->
            <section class="mt-20">
                <h2 class="text-3xl font-bold text-slate-900 mb-10 text-center">Apa Kata Mereka Tentang Layanan Kami?</h2>
                <div class="flex overflow-x-auto gap-6 pb-8 snap-x snap-mandatory no-scrollbar">
                    <div class="min-w-[320px] snap-center bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
                        <div class="flex gap-1 mb-4 text-yellow-400">
                            {[1,2,3,4,5].map(() => <span class="text-lg">★</span>)}
                        </div>
                        <p class="text-slate-600 italic mb-6">"Pelayanan pembelian tiket PELNI sangat cepat, respon admin di WA juga ramah. Gak perlu capek antre di pelabuhan lagi."</p>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center font-bold text-blue-600 text-sm">CC</div>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm">Ceica Cantika</h4>
                                <p class="text-slate-400 text-xs">Pelanggan Setia</p>
                            </div>
                        </div>
                    </div>
                    <div class="min-w-[320px] snap-center bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
                        <div class="flex gap-1 mb-4 text-yellow-400">
                            {[1,2,3,4,5].map(() => <span class="text-lg">★</span>)}
                        </div>
                        <p class="text-slate-600 italic mb-6">"Bisa jadi opsi untuk pemesanan tiket secara online, tidak perlu lagi ke pelabuhan. Langsung diproses dan tiket aman."</p>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center font-bold text-orange-600 text-sm">UR</div>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm">Uriel</h4>
                                <p class="text-slate-400 text-xs">Pelanggan</p>
                            </div>
                        </div>
                    </div>
                    <div class="min-w-[320px] snap-center bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
                        <div class="flex gap-1 mb-4 text-yellow-400">
                            {[1,2,3,4,5].map(() => <span class="text-lg">★</span>)}
                        </div>
                        <p class="text-slate-600 italic mb-6">"Sangat terbantu untuk cek jadwal kapal terbaru. Informatif dan layanannya benar-benar memuaskan."</p>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center font-bold text-green-600 text-sm">SS</div>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm">Sahia</h4>
                                <p class="text-slate-400 text-xs">Local Guide</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- FAQ Section -->
            <section class="mt-20 bg-slate-50 p-8 md:p-12 rounded-[40px] border border-slate-100">
                <h2 class="text-3xl font-bold text-slate-900 mb-10 text-center">Tanya Jawab Seputar Jadwal & Tiket PELNI Baubau</h2>
                <div class="grid md:grid-cols-2 gap-8">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:border-blue-400 transition-colors">
                        <h3 class="font-bold text-slate-900 mb-3">Kapan jadwal kapal PELNI Baubau Mei 2026 keluar secara lengkap?</h3>
                        <p class="text-sm">Jadwal resmi biasanya dirilis 1-2 minggu sebelum keberangkatan. One Creative selalu memperbarui data segera setelah sistem pusat PELNI merilis jadwal terbaru untuk wilayah Baubau.</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:border-blue-400 transition-colors">
                        <h3 class="font-bold text-slate-900 mb-3">Bagaimana cara beli tiket PELNI Baubau secara online?</h3>
                        <p class="text-sm">Anda bisa mengirimkan foto KTP/SIM melalui WhatsApp ke nomor admin One Creative. Kami akan mengecek ketersediaan kursi dan memproses pembayaran secara digital.</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:border-blue-400 transition-colors">
                        <h3 class="font-bold text-slate-900 mb-3">Berapa harga tiket kapal PELNI dari Baubau ke Makassar?</h3>
                        <p class="text-sm">Harga tiket bervariasi tergantung usia (Dewasa/Bayi) dan kelas. Silakan hubungi admin kami untuk mendapatkan rincian harga tiket kapal laut terbaru.</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:border-blue-400 transition-colors">
                        <h3 class="font-bold text-slate-900 mb-3">Dimana lokasi Pelabuhan Murhum di Baubau?</h3>
                        <p class="text-sm">Pelabuhan Murhum terletak di pusat Kota Baubau. Ini adalah pelabuhan utama untuk semua kapal PELNI rute Nusantara yang singgah di Pulau Buton.</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:border-blue-400 transition-colors">
                        <h3 class="font-bold text-slate-900 mb-3">Apakah tiket yang dibeli di One Creative bisa langsung digunakan?</h3>
                        <p class="text-sm">Ya, tiket yang kami berikan adalah tiket elektronik resmi. Anda cukup menunjukkannya atau mencetaknya saat proses boarding di pelabuhan.</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:border-blue-400 transition-colors">
                        <h3 class="font-bold text-slate-900 mb-3">Apakah One Creative melayani pengiriman paket via PELNI?</h3>
                        <p class="text-sm">Tentu, selain tiket penumpang, kami juga melayani jasa ekspedisi logistik untuk pengiriman paket barang ke berbagai rute tujuan kapal PELNI.</p>
                    </div>
