---

<Layout 
    title="Blog One Creative — Info Percetakan & Tiket Murah Bau-Bau Buton"
    description="Kumpulan artikel seputar jasa print, percetakan murah, tiket pesawat, dan layanan digital terbaik di wilayah Kota Bau-Bau dan Kabupaten Buton."
>
    <main class="pt-32 pb-24 bg-slate-50 min-h-screen">
        <div class="container mx-auto px-6 max-w-5xl">
            <header class="text-center mb-16">
                <h1 class="text-[40px] md:text-[56px] font-semibold mb-6">Blog One Creative</h1>
                <p class="text-slate-500 text-lg max-w-2xl mx-auto">Informasi terbaru seputar dunia digital, percetakan, dan tips perjalanan murah di Bau-Bau Buton.</p>
            </header>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                {posts.map(post => (
                    <article class="bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
                        <img src={post.img} alt={post.title} class="w-full h-48 object-cover">
                        <div class="p-6">
                            <p class="text-xs text-slate-400 mb-2 font-bold uppercase tracking-widest">{post.date}</p>
                            <h2 class="text-xl font-bold mb-3 hover:text-[#4fbed4] transition-colors">
                                <a href={post.url}>{post.title}</a>
                            </h2>
                            <p class="text-slate-500 text-sm mb-6 line-clamp-3">{post.desc}</p>
                            <a href={post.url} class="text-[#4fbed4] font-bold text-sm flex items-center gap-2">
                                Baca Selengkapnya 
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                            </a>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </main>
</Layout>
