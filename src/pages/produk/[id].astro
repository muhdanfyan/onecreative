const { id } = Astro.params;
const { product } = Astro.props;
const currentUrl = `https://www.onecreative.id/produk/${id}`;
---

<Layout 
    title={`${product.name} — One Creative Bau-Bau`}
    description={`Informasi detail mengenai ${product.name} di One Creative Bau-Bau. Dapatkan layanan terbaik dengan harga kompetitif.`}
    ogImage={product.image}
>
    <!-- Navbar -->
    <nav class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <a href="/" class="flex items-center gap-4">
                <img src="/img/logo.png" alt="One Creative Logo" class="h-8 w-auto">
            </a>
            <a href="/#produk" class="text-sm font-semibold text-slate-600 hover:text-black">Kembali ke Produk</a>
        </div>
    </nav>

    <!-- Product Detail Content -->
    <main class="pt-32 pb-24">
        <div class="container mx-auto px-6 max-w-6xl">
            <article class="grid md:grid-cols-2 gap-16 items-start">
                
                <!-- Product Image -->
                <div class="sticky top-32">
                    <div class="rounded-2xl overflow-hidden shadow-2xl border border-slate-100">
                        <img src={product.image} alt={product.name} class="w-full aspect-square object-cover">
                    </div>
                </div>

                <!-- Product Info -->
                <section>
                    <div class="inline-block bg-[#4fbed4]/10 text-[#4fbed4] px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-6">
                        {product.badge}
                    </div>
                    <h1 class="text-[40px] md:text-[56px] font-semibold leading-tight mb-4 text-slate-900">
                        {product.name}
                    </h1>
                    <div class="flex items-center gap-4 mb-8">
                        <span class="text-xl text-slate-400 line-through">{product.priceOld}</span>
                        <span class="text-3xl font-bold text-[#4fbed4]">{product.priceNew}</span>
                    </div>

                    <div class="text-lg text-slate-600 leading-relaxed mb-10 space-y-4" set:html={product.description}>
                    </div>

                    <div class="flex flex-col gap-4">
                        <a href={product.waLink} target="_blank" class="btn-primary text-white text-center py-5 rounded-lg font-bold text-xl shadow-xl shadow-[#4fbed4]/20">
                            Pesan via WhatsApp
                        </a>
                        <p class="text-center text-sm text-slate-400">Tersedia untuk area Bau-Bau & sekitarnya.</p>
                    </div>

                    <ShareButtons url={currentUrl} title={product.name} />

                    <!-- Features Section -->
                    <div class="mt-16 pt-16 border-t border-slate-100">
                        <h2 class="text-2xl font-bold mb-8">Keunggulan Layanan</h2>
                        <div class="grid gap-6">
                            {product.features.map(feature => (
                                <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 hover:border-[#4fbed4]/20 transition-colors">
                                    <h3 class="font-bold text-slate-900 mb-2">{feature.title}</h3>
                                    <p class="text-sm text-slate-500 leading-relaxed">{feature.desc}</p>
                                </div>
                            ))}
                        </div>
                    </div>
                </section>
            </article>
        </div>
    </main>

    <footer class="bg-slate-50 py-12 border-t border-slate-200">
        <div class="container mx-auto px-6 text-center">
            <div class="flex justify-center gap-8 mb-6">
                <a href="https://www.instagram.com/onecreativeaio/" class="text-slate-400 hover:text-[#4fbed4] transition-colors text-sm" target="_blank">Instagram</a>
                <a href="https://www.facebook.com/onecreativeaio" class="text-slate-400 hover:text-[#4fbed4] transition-colors text-sm" target="_blank">Facebook</a>
                <a href="https://www.youtube.com/watch?v=fdk8niTzUD8" class="text-slate-400 hover:text-[#4fbed4] transition-colors text-sm" target="_blank">YouTube</a>
            </div>
            <p class="text-slate-600 font-semibold mb-4">WhatsApp: +62 857-9679-2110</p>
            <p class="text-slate-400 text-sm">&copy; 2026 One Creative ID. Solusi Digital Terpercaya di Bau-Bau.</p>
        </div>
    </footer>
</Layout>
