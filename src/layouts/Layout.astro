---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const { 
    title = "Percetakan Bau-Bau - Tiket Murah & Layanan Digital One Creative", 
    description = "Percetakan Bau-Bau terbaik dan terlengkap. One Creative melayani jasa cetak undangan, tiket pesawat, agen PELNI, dan top up game murah di Kota Bau-Bau.",
    ogImage = "/img/hero-bg.png"
} = Astro.props;

const siteUrl = "https://www.onecreative.id";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString();
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Google Analytics Placeholder -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());
		  gtag('config', 'G-XXXXXXXXXX');
		</script>

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content="Percetakan Bau-Bau, Cetak Undangan Bau-Bau, Tiket Pesawat Murah Bau-Bau, Agen Pelni Bau-Bau, Top Up Game Bau-Bau, Expedisi Bau-Bau, One Creative Bau-Bau, print bau-bau, percetakan buton, tiket murah buton" />
		<meta name="author" content="One Creative ID" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<link rel="canonical" href={canonicalURL} />
		
		<!-- Geo Tags (New Tech) -->
		<meta name="geo.region" content="ID-SG" />
		<meta name="geo.placename" content="Bau-Bau" />
		<meta name="geo.position" content="-5.475193;122.588271" />
		<meta name="ICBM" content="-5.475193, 122.588271" />

		<!-- Open Graph / Facebook (Rich Link Preview) -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content="One Creative Bau-Bau Buton" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600&display=swap" rel="stylesheet">

		<!-- JSON-LD Structured Data (Local Business) -->
		<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "LocalBusiness",
		  "name": "One Creative",
		  "image": "https://www.onecreative.id/img/logo.png",
		  "@id": "https://www.onecreative.id",
		  "url": "https://www.onecreative.id",
		  "telephone": "+6285796792110",
		  "address": {
			"@type": "PostalAddress",
			"streetAddress": "Jl. Gajah Mada, Lipu, Kec. Betoambari",
			"addressLocality": "Bau-Bau",
			"addressRegion": "Sulawesi Tenggara",
			"postalCode": "93721",
			"addressCountry": "ID"
		  },
		  "geo": {
			"@type": "GeoCoordinates",
			"latitude": -5.4751928,
			"longitude": 122.5882712
		  },
		  "openingHoursSpecification": {
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": [
			  "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
			],
			"opens": "08:30",
			"closes": "22:00"
		  },
		  "sameAs": [
			"https://www.facebook.com/onecreativeaio",
			"https://www.instagram.com/onecreativeaio/",
			"https://www.youtube.com/@onecreativeaio"
		  ]
		}
		</script>

		<!-- JSON-LD Structured Data (FAQPage) -->
		<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "FAQPage",
		  "mainEntity": [
			{
			  "@type": "Question",
			  "name": "Dimana lokasi percetakan dan layanan digital One Creative di Bau-Bau?",
			  "acceptedAnswer": {
				"@type": "Answer",
				"text": "Kantor pusat One Creative terletak strategis di Jl. Gajah Mada, Lipu, Kec. Betoambari, Kota Bau-Bau, Sulawesi Tenggara 93721. Anda bisa datang langsung ke workshop kami untuk layanan cetak, tiket, dan top up."
			  }
			},
			{
			  "@type": "Question",
			  "name": "Apakah One Creative melayani cetak undangan pernikahan yang bisa ditunggu?",
			  "acceptedAnswer": {
				"@type": "Answer",
				"text": "Tentu! Kami menyediakan layanan cetak undangan pernikahan (seperti katalog Erba) dan dokumen dengan teknologi laser terbaru yang memungkinkan proses pengerjaan cepat dengan hasil tajam."
			  }
			},
			{
			  "@type": "Question",
			  "name": "Layanan pembayaran (PPOB) apa saja yang tersedia?",
			  "acceptedAnswer": {
				"@type": "Answer",
				"text": "Sebagai PPOB terlengkap di Bau-Bau, kami melayani pembayaran tagihan listrik PLN, air PDAM, BPJS, gas PGN, internet (Indihome, MyRepublic), TV kabel, hingga cicilan multifinance."
			  }
			},
			{
			  "@type": "Question",
			  "name": "Apakah bisa top up game murah seperti MLBB dan FreeFire di sini?",
			  "acceptedAnswer": {
				"@type": "Answer",
				"text": "Sangat bisa. Kami menawarkan top up diamond MLBB, FreeFire, PUBG, and Steam Wallet dengan harga yang sangat bersaing and proses instan 24 jam untuk gamers di wilayah Bau-Bau."
			  }
			},
			{
			  "@type": "Question",
			  "name": "Apakah One Creative agen resmi tiket pesawat dan PELNI?",
			  "acceptedAnswer": {
				"@type": "Answer",
				"text": "Ya, kami adalah agen resmi yang melayani pemesanan tiket pesawat (termasuk flight last-minute) untuk rute domestik and internasional, serta reservasi resmi tiket kapal laut PELNI tanpa antre."
			  }
			}
		  ]
		}
		</script>

		<!-- Breadcrumb Schema (New Tech) -->
		<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "BreadcrumbList",
		  "itemListElement": [{
			"@type": "ListItem",
			"position": 1,
			"name": "Beranda",
			"item": "https://www.onecreative.id"
		  }]
		}
		</script>
		<slot name="head" />
	</head>
	<body class="selection:bg-[#4fbed4]/20">
		<nav class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
			<div class="container mx-auto px-6 py-4 flex justify-between items-center">
				<a href="/" class="flex items-center gap-4">
					<img src="/img/logo.png" alt="Logo One Creative Bau-Bau" class="h-8 w-auto">
				</a>
				<div class="hidden md:flex items-center gap-8">
					<a href="/#produk" class="text-sm font-bold text-slate-600 hover:text-[#4fbed4] transition-colors lang-text" data-id="Produk" data-en="Products">Produk</a>
					<a href="/blog" class="text-sm font-bold text-slate-600 hover:text-[#4fbed4] transition-colors lang-text" data-id="Blog" data-en="Blog">Blog</a>
					<a href="/#tentang" class="text-sm font-bold text-slate-600 hover:text-[#4fbed4] transition-colors lang-text" data-id="Tentang Kami" data-en="About Us">Tentang Kami</a>
					<button id="langToggle" class="flex items-center gap-2 px-3 py-1.5 bg-slate-100 rounded-lg text-sm font-bold hover:bg-[#4fbed4] hover:text-white transition-all">
						<span id="langLabel">ID</span>
					</button>
				</div>
			</div>
		</nav>

		<slot />

		<Footer />

		<script is:inline>
			let currentLang = localStorage.getItem('lang') || 'id';

			function updateLanguageUI() {
				const label = document.getElementById('langLabel');
				if (label) label.innerText = currentLang.toUpperCase();
				
				// Update all elements with [data-id][data-en]
				document.querySelectorAll('[data-id][data-en]').forEach(el => {
					el.innerText = currentLang === 'en' ? el.dataset.en : el.dataset.id;
				});
			}

			document.getElementById('langToggle')?.addEventListener('click', () => {
				currentLang = currentLang === 'id' ? 'en' : 'id';
				localStorage.setItem('lang', currentLang);
				updateLanguageUI();
			});

			updateLanguageUI();
		</script>
	</body>
</html>
