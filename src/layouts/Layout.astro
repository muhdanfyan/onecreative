---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "One Creative Bau-Bau: Jasa cetak undangan pernikahan, tiket pesawat murah, agen PELNI resmi, top up game termurah, dan ekspedisi kirim paket terbaik di Kota Bau-Bau." } = Astro.props;
const siteUrl = "https://www.onecreative.id";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL('/img/hero-bg.png', siteUrl);
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content="percetakan bau-bau, digital printing bau-bau, cetak undangan bau-bau, tiket pesawat murah bau-bau, agen pelni bau-bau, top up game murah bau-bau, jasa desain grafis bau-bau, ekspedisi paket bau-bau, one creative bau-bau" />
		<meta name="author" content="One Creative ID" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook (Rich Link Preview) -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content="One Creative Bau-Bau" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600&display=swap" rel="stylesheet">

		<!-- JSON-LD Structured Data (Local Business) -->
		<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "LocalBusiness",
		  "name": "One Creative",
		  "image": "https://www.onecreative.id/img/logo.png",
		  "@id": "https://www.onecreative.id",
		  "url": "https://www.onecreative.id",
		  "telephone": "+6285796792110",
		  "address": {
			"@type": "PostalAddress",
			"streetAddress": "Jl. Gajah Mada, Lipu, Kec. Betoambari",
			"addressLocality": "Bau-Bau",
			"addressRegion": "Sulawesi Tenggara",
			"postalCode": "93721",
			"addressCountry": "ID"
		  },
		  "geo": {
			"@type": "GeoCoordinates",
			"latitude": -5.4751928,
			"longitude": 122.5882712
		  },
		  "openingHoursSpecification": {
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": [
			  "Monday",
			  "Tuesday",
			  "Wednesday",
			  "Thursday",
			  "Friday",
			  "Saturday",
			  "Sunday"
			],
			"opens": "08:30",
			"closes": "22:00"
		  },
		  "sameAs": [
			"https://www.facebook.com/onecreativeaio",
			"https://www.instagram.com/onecreative.id/",
			"https://www.youtube.com/watch?v=fdk8niTzUD8"
		  ]
		}
		</script>

		<!-- JSON-LD Structured Data (FAQPage) -->
		<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "FAQPage",
		  "mainEntity": [
			{
			  "@type": "Question",
			  "name": "Dimana lokasi percetakan dan layanan digital One Creative di Bau-Bau?",
			  "acceptedAnswer": {
				"@type": "Answer",
				"text": "Kantor pusat One Creative terletak strategis di Jl. Gajah Mada, Lipu, Kec. Betoambari, Kota Bau-Bau, Sulawesi Tenggara 93721. Anda bisa datang langsung ke workshop kami untuk layanan cetak, tiket, dan top up."
			  }
			},
			{
			  "@type": "Question",
			  "name": "Apakah One Creative melayani cetak undangan pernikahan yang bisa ditunggu?",
			  "acceptedAnswer": {
				"@type": "Answer",
				"text": "Tentu! Kami menyediakan layanan cetak undangan pernikahan (seperti katalog Erba) dan dokumen dengan teknologi laser terbaru yang memungkinkan proses pengerjaan cepat dengan hasil tajam."
			  }
			},
			{
			  "@type": "Question",
			  "name": "Layanan pembayaran (PPOB) apa saja yang tersedia?",
			  "acceptedAnswer": {
				"@type": "Answer",
				"text": "Sebagai PPOB terlengkap di Bau-Bau, kami melayani pembayaran tagihan listrik PLN, air PDAM, BPJS, gas PGN, internet (Indihome, MyRepublic), TV kabel, hingga cicilan multifinance."
			  }
			},
			{
			  "@type": "Question",
			  "name": "Apakah bisa top up game murah seperti MLBB dan FreeFire di sini?",
			  "acceptedAnswer": {
				"@type": "Answer",
				"text": "Sangat bisa. Kami menawarkan top up diamond MLBB, FreeFire, PUBG, dan Steam Wallet dengan harga yang sangat bersaing dan proses instan 24 jam untuk gamers di wilayah Bau-Bau."
			  }
			},
			{
			  "@type": "Question",
			  "name": "Apakah One Creative agen resmi tiket pesawat dan PELNI?",
			  "acceptedAnswer": {
				"@type": "Answer",
				"text": "Ya, kami adalah agen resmi yang melayani pemesanan tiket pesawat (termasuk flight last-minute) untuk rute domestik dan internasional, serta reservasi resmi tiket kapal laut PELNI tanpa antre."
			  }
			}
		  ]
		}
		</script>
	</head>
	<body class="selection:bg-[#4fbed4]/20">
		<slot />
	</body>
</html>
